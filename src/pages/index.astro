---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="page-main">
    <header class="hero">
      <h1>Luka <span>Mucko</span></h1>
      <p id="status-line" class="status">Vienna · --:--</p>
    </header>
    <section class="content">
      <div class="section-list">
        <section class="section-row">
          <p class="section-label">Now</p>
          <p class="section-copy">
            Scientific Intern at
            <a href="https://aithyra.at/" target="_blank" rel="noreferrer"
              >AITHYRA</a
            >, working on AI for medical sciences with
            <a href="https://www.alextong.net/" target="_blank" rel="noreferrer"
              >Alex&nbsp;Tong</a
            >.
          </p>
        </section>
        <section class="section-row">
          <p class="section-label">Previously</p>
          <p class="section-copy">
            Worked with Alán Aspuru-Guzik on crystal structure prediction and
            machine learning for computational chemistry. Studied computing at the University of Zagreb.
          </p>
        </section>
        <section class="section-row">
          <p class="section-label">Interests</p>
          <p class="section-copy">
            Sampling, measure transport, diffusion, and flows. With applications to chemistry and biology.
          </p>
        </section>
      </div>
      <div class="button-group">
        <a href="/bio" class="btn bio-btn">Bio</a>
        <a
          href="https://github.com/LukaMucko"
          class="btn github-btn"
          target="_blank"
          rel="noreferrer"
        >
          GitHub
        </a>
        <button class="btn main-btn" type="button">Email Me</button>
      </div>
    </section>
    <div
      id="email-modal"
      class="email-modal hidden"
      role="dialog"
      aria-modal="true"
      aria-label="Email"
    >
      <button class="modal-close" type="button" aria-label="Close">
        ×
      </button>
      <div class="email-list">
        <p class="email-row">
          <span class="email-kind">professional</span>
          <span class="email-value-group">
            <span id="work-email-value" class="email-value"></span>
            <button class="btn copy-btn" type="button" data-email-target="work">
              Copy
            </button>
          </span>
        </p>
        <p class="email-row">
          <span class="email-kind">personal</span>
          <span class="email-value-group">
            <span id="personal-email-value" class="email-value"></span>
            <button class="btn copy-btn" type="button" data-email-target="personal">
              Copy
            </button>
          </span>
        </p>
      </div>
    </div>
  </main>
</Layout>
<style>
  .hero {
    max-width: 860px;
  }
  header h1 {
    font-family: "Courier";
    font-size: 3rem;
    font-weight: normal;
    margin: 0 0 1rem;
  }
  header h1 span {
    color: var(--text-color);
  }
  .content {
    max-width: 980px;
    line-height: 1.4;
    font-size: 1rem;
    margin-top: 2rem;
  }
  .section-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }
  .section-row {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.25rem;
    border: 2px solid var(--text-color);
    box-shadow: 4px 4px 0px var(--shadow-color);
    background: rgba(16, 21, 16, 0.45);
  }
  .section-label {
    font-family: "Courier";
    font-size: 1rem;
    margin: 0;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .section-copy {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }
  .section-copy a {
    color: var(--text-color);
    text-decoration: none;
    border-bottom: 2px solid var(--accent-color);
  }
  .meta-line {
    font-size: 0.95rem;
    line-height: 1.6;
    opacity: 0.85;
    max-width: 48rem;
    margin: 0 0 2rem;
  }
  .button-group .btn {
    width: 200px;
    text-align: center;
    box-sizing: border-box;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .button-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .main-btn {
    font-weight: bold;
    padding: 0.8rem 2rem;
    font-size: 1.5rem;
  }
  .email-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg-color);
    border: 5px solid var(--text-color);
    padding: 2.5rem 3rem;
    box-shadow: 20px 20px 0px var(--shadow-color);
    text-align: center;
    z-index: 1000;
    min-width: 360px;
    max-width: 90vw;
  }
  .modal-close {
    position: absolute;
    top: 0.5rem;
    right: 0.7rem;
    background: transparent;
    border: none;
    color: var(--text-color);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    padding: 0;
    transition: color 0.1s;
  }
  .modal-close:hover {
    color: var(--accent-color);
  }
  .status {
    font-family: "Courier New", Courier, monospace;
    font-size: 1rem;
    margin: 0 0 0.3rem;
    opacity: 0.85;
  }
  .status::before {
    content: "•";
    color: var(--accent-color);
    margin-right: 0.4rem;
  }
  .email-value {
    font-family: "Courier New", Courier, monospace;
    font-size: 1.05rem;
    margin: 0;
    word-break: break-all;
  }
  .email-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .email-row {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
  }
  .email-kind {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-color);
  }
  .email-value-group {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }
  .copy-btn {
    font-size: 1rem;
    padding: 0.45rem 1rem;
    flex: 0 0 auto;
  }
  .hidden {
    display: none !important;
  }
  @media (max-width: 768px) {
    header h1 {
      font-size: 2.15rem;
    }
    .section-row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
    .email-modal {
      width: 85%;
      padding: 2rem;
    }
    .email-value {
      font-size: 1rem;
    }
    .status {
      font-size: 0.9rem;
    }
    .meta-line {
      font-size: 0.95rem;
    }
  }
</style>

<script>
  const btn = document.querySelector(".main-btn");
  const modal = document.getElementById("email-modal");
  const workEmailValue = document.getElementById("work-email-value");
  const personalEmailValue = document.getElementById("personal-email-value");
  const statusLine = document.getElementById("status-line");
  const closeBtn = document.querySelector(".modal-close");
  const key = "secret key";
  const encodedWorkEmail = "HwgWEQ4bYAoMDRscERNLFVQ=";
  const encodedPersonalEmail = "HxAIE0sZVQgOFjMCDhMMGA4IChQ=";

  const decodeEmail = (encoded: string, secret: string) => {
    const bytes = Uint8Array.from(atob(encoded), (c) => c.charCodeAt(0));
    let result = "";
    for (let i = 0; i < bytes.length; i++) {
      result += String.fromCharCode(
        bytes[i] ^ secret.charCodeAt(i % secret.length),
      );
    }
    return result;
  };

  const encodeEmail = (text: string, secret: string) => {
    const bytes = Array.from(text, (char, i) =>
      char.charCodeAt(0) ^ secret.charCodeAt(i % secret.length),
    );
    return btoa(String.fromCharCode(...bytes));
  };

  const revealEmails = () => {
    const decodedWork = decodeEmail(encodedWorkEmail, key);
    const decodedPersonal = decodeEmail(encodedPersonalEmail, key);
    if (workEmailValue) workEmailValue.textContent = decodedWork;
    if (personalEmailValue) personalEmailValue.textContent = decodedPersonal;
  };

  const hideEmails = () => {
    if (workEmailValue) {
      workEmailValue.textContent = encodeEmail(
        decodeEmail(encodedWorkEmail, key),
        key,
      );
    }
    if (personalEmailValue) {
      personalEmailValue.textContent = encodeEmail(
        decodeEmail(encodedPersonalEmail, key),
        key,
      );
    }
  };

  if (btn) {
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      revealEmails();
      if (modal) modal.classList.remove("hidden");
    });
  }

  const closeModal = () => {
    if (modal && !modal.classList.contains("hidden")) {
      modal.classList.add("hidden");
      hideEmails();
    }
  };

  const copyToClipboard = async (text: string) => {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    const temp = document.createElement("textarea");
    temp.value = text;
    temp.setAttribute("readonly", "true");
    temp.style.position = "absolute";
    temp.style.left = "-9999px";
    document.body.appendChild(temp);
    temp.select();
    document.execCommand("copy");
    document.body.removeChild(temp);
  };

  for (const copyBtn of document.querySelectorAll(".copy-btn")) {
    copyBtn.addEventListener("click", async (e) => {
      e.stopPropagation();
      const decoded =
        copyBtn.dataset.emailTarget === "work"
          ? decodeEmail(encodedWorkEmail, key)
          : decodeEmail(encodedPersonalEmail, key);
      await copyToClipboard(decoded);
      copyBtn.textContent = "Copied";
      setTimeout(() => {
        copyBtn.textContent = "Copy";
      }, 1200);
    });
  }

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.classList.contains("hidden")) {
      closeModal();
    }
  });

  if (closeBtn) {
    closeBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      closeModal();
    });
  }

  const formatTime = () => {
    const now = new Date();
    return new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Vienna",
      hour: "2-digit",
      minute: "2-digit",
      hour12: false,
    }).format(now);
  };

  const updateStatus = () => {
    if (!statusLine) return;
    statusLine.textContent = `Vienna · ${formatTime()}`;
  };

  updateStatus();
  setInterval(updateStatus, 30000);
  hideEmails();
</script>
