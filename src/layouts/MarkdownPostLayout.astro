---
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
const title = frontmatter.title || "Blog";
const description = frontmatter.description || "";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : null;
const formatDate = (value) => {
    if (!value) return "";
    const date = value instanceof Date ? value : new Date(value);
    if (Number.isNaN(date.valueOf())) return "";
    return date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "short",
        day: "2-digit",
    });
};
---

<Layout
    title={title}
    description={description}
    ogType="article"
    canonical={canonical?.toString()}
>
    <Fragment slot="head">
        {
            frontmatter.math !== false && (
                <>
                    <script is:inline>
                        window.MathJax = {
                            tex: {
                                inlineMath: [
                                    ["$", "$"],
                                    ["\\(", "\\)"],
                                ],
                                displayMath: [
                                    ["$$", "$$"],
                                    ["\\[", "\\]"],
                                ],
                            },
                            options: {
                                skipHtmlTags: [
                                    "script",
                                    "noscript",
                                    "style",
                                    "textarea",
                                    "pre",
                                    "code",
                                ],
                            },
                        };
                    </script>
                    <script
                        async
                        src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"
                    />
                </>
            )
        }
    </Fragment>
    <main class="page-main">
        <header class="page-header">
            <a href="/blog" class="btn back-btn">← Back</a>
            <h1>{frontmatter.title}</h1>
            <div class="meta">
                {
                    frontmatter.pubDate && (
                        <time>{formatDate(frontmatter.pubDate)}</time>
                    )
                }
            </div>
        </header>
        <article class="content">
            <slot />
        </article>
    </main>
    <script type="module" src="/scripts/interactive-figures.js"></script>
</Layout>

<style>
    .page-header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.5rem;
        margin-bottom: 3rem;
        border-bottom: 2px solid var(--accent-color);
        padding-bottom: 1rem;
    }
    .page-header h1 {
        font-family: "Courier";
        font-size: 2.5rem;
        font-weight: normal;
        margin: 0;
    }
    .meta {
        display: flex;
        align-items: center;
        font-family: "Courier New", Courier, monospace;
        font-size: 0.9rem;
    }
    .back-btn {
        width: fit-content;
    }
    .content {
        font-family: "Courier New", Courier, monospace;
        font-size: 1.1rem;
        line-height: 1.6;
    }
    /* Brutalist typography for markdown content */
    .content :global(h1),
    .content :global(h2),
    .content :global(h3) {
        font-family: "Courier";
        font-weight: normal;
        margin-top: 2rem;
        margin-bottom: 1rem;
    }
    .content :global(p) {
        margin-bottom: 1.5rem;
    }
    .content :global(a) {
        color: var(--text-color);
        text-decoration: none;
        border-bottom: 2px solid var(--accent-color);
    }
    .content :global(code) {
        background: #141a13;
        color: var(--text-color);
        padding: 0.1rem 0.25rem;
        font-size: 0.9rem;
        border-radius: 2px;
    }
    .content :global(pre) :global(code) {
        padding: 0;
        background: transparent;
    }
    .content :global(pre) {
        background: var(--code-bg);
        color: var(--text-color);
        padding: 1rem 1.2rem;
        overflow-x: auto;
        border: 1px solid var(--code-border);
        box-shadow: 6px 6px 0px var(--code-shadow);
    }
    .content :global(.interactive-figure > *) {
        display: block;
        font-size: initial;
        line-height: normal;
    }
    .content :global(.interactive-figure) {
        margin: 2rem calc(50% - min(46vw, 620px));
        border: 2px solid var(--text-color);
        background: var(--bg-color);
        box-shadow: 8px 8px 0px var(--accent-color);
        overflow: hidden;
    }
    @media (max-width: 760px) {
        .content :global(.interactive-figure) {
            margin: 2rem -1rem;
        }
    }
</style>
